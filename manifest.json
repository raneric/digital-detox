{
  "manifest_version": 3,
  "name": "Digital Detox — Social Media Time Limiter",
  "description": "Set a daily time limit per social media site. When the limit is reached, the site is blocked for the rest of the day.",
  "version": "1.0.0",
  "minimum_chrome_version": "121",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "declarativeNetRequest"
  ],
  "background": {
    "service_worker": "src/background/main.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Digital Detox",
    "default_icon": {
      "16": "src/assets/icon16.png",
      "48": "src/assets/icon48.png",
      "128": "src/assets/icon128.png"
    }
  },
  "icons": {
    "16": "src/assets/icon16.png",
    "48": "src/assets/icon48.png",
    "128": "src/assets/icon128.png"
  },
  "options_page": "src/popup/popup.html?view=options",
  "declarative_net_request": {
    "rule_resources": []
  },
  "host_permissions": ["https://medium.com/*"]
}
